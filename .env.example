# ============================================================
# Match Corna Live — environment config
# ============================================================
# Copy this file to .env and fill in the two secret values below.
# Everything else is already set to what we configured together
# this whole build — safe to leave as-is.
#
#   cp .env.example .env
#   nano .env      # fill in FB_PAGE_ID and FB_PAGE_ACCESS_TOKEN
#
# IMPORTANT: paste the token on its own line, and scroll to the end
# of the line afterward to confirm it's not cut off — long tokens
# have gotten truncated before on mobile keyboards. Verify with:
#
#   python3 -c "
#   with open('.env') as f:
#       for line in f:
#           if line.startswith('FB_PAGE_ACCESS_TOKEN'):
#               print('Token length:', len(line.strip().split('=',1)[1]))
#   "
#
# A real long-lived Page token is typically 190+ characters.
# ============================================================

# ---- REQUIRED: fill these in ----
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ---- Already configured from our earlier sessions ----

# Daily match preview post time (UTC). 7 = 9am Malawi time (UTC+2).
DAILY_PREVIEW_HOUR=7

# A kickoff/goal/red-card event older than this (minutes) by the time
# it's about to post gets retried for up to 15 more real minutes (in
# case the source data was just delayed/rate-limited), then skipped
# for good instead of posted late/out of order.
MAX_EVENT_AGE_MINUTES=15

# ---- Optional, leave commented unless you want to change a default ----
# POLL_INTERVAL=60
# MAX_POSTS_PER_HOUR=25
