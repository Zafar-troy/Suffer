# ============================================================
# Match Corna Live — environment config
# ============================================================
# Copy this file to .env and fill in the two secret values below.
#
#   cp .env.example .env
#   nano .env      # fill in FB_PAGE_ID and FB_PAGE_ACCESS_TOKEN
#
# On Railway: don't use a .env file at all — add these same names as
# real environment variables in the Railway project's Variables tab.
# config.py reads real env vars automatically either way.
# ============================================================

# ---- REQUIRED: fill these in ----
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ---- Bot mode ----
# developer = runs normally but never actually posts to Facebook
#             (prints what would have been posted instead) — use this
#             to test safely without touching the credentials above.
# active    = posts for real. Also the fail-safe default: any typo
#             here (anything that isn't exactly "active") is treated
#             as developer mode, so a mistake can't accidentally go live.
BOT_MODE=active

# ---- League on/off ----
# These are only the FALLBACK for any league not listed in leagues.json
# (repo root). If you're editing leagues.json on GitHub to control
# which leagues post, you can leave everything below as-is — it's
# only used for a league leagues.json doesn't mention, or if
# leagues.json is deleted entirely.
LEAGUE_PREMIER_LEAGUE=true
LEAGUE_LA_LIGA=true
LEAGUE_SERIE_A=true
LEAGUE_BUNDESLIGA=true
LEAGUE_LIGUE_1=true
LEAGUE_EREDIVISIE=true
LEAGUE_MLS=true
LEAGUE_BRAZIL_SERIE_A=true
LEAGUE_SAUDI_PRO_LEAGUE=true
LEAGUE_SOUTH_AFRICAN_PREMIERSHIP=true
LEAGUE_MALAWI_SUPER_LEAGUE=true
LEAGUE_SUPER_LIG=true
LEAGUE_LIGA_MX=true

# Daily match preview post time (UTC). 7 = 9am Malawi time (UTC+2).
DAILY_PREVIEW_HOUR=7

# A kickoff/goal/red-card event older than this (minutes) by the time
# it's about to post gets retried for up to 3 more real minutes (in
# case the source data was just delayed/rate-limited), then skipped
# for good instead of posted late/out of order.
MAX_EVENT_AGE_MINUTES=15

# ---- Optional, leave commented unless you want to change a default ----
# POLL_INTERVAL=60
# MAX_POSTS_PER_HOUR=50
# PORT=8080

# ---- Railway persistent storage (see README) ----
# Uncomment and point at your mounted Volume's path once you've added
# one in Railway, so posted-event/fixture tracking survives redeploys
# instead of resetting (which causes duplicate reposts).
# DATA_DIR=/data
